# ─────────────────────────────────────────────────────────────
#  Independent Dealer License — Environment Variables
#  Copy this file to `.env.local` and fill in the real values.
#  On Vercel, add these under Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://independentdealerlicense.com

# Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# ── Admin panel ──────────────────────────────────────────────
# The plain password you type on /admin. Used if ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=change-this-to-a-long-random-password

# OPTIONAL: a bcrypt hash of the admin password. If set, it takes priority
# over ADMIN_PASSWORD. Generate with:  npx bcryptjs-cli "your-password"
# or node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
ADMIN_PASSWORD_HASH=

# A long random string used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-secret-string

# ── GitHub (post storage) ────────────────────────────────────
# Classic Personal Access Token with the "repo" scope.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=independentdealerlicense
# Branch the posts are committed to (defaults to main).
GITHUB_BRANCH=main

# ── Vercel (optional) ────────────────────────────────────────
# Deploy Hook URL from Vercel → Project Settings → Git → Deploy Hooks.
# If left blank, Vercel still redeploys automatically on the GitHub push.
VERCEL_DEPLOY_HOOK=
